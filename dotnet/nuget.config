<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- <clear /> is not tidiness. Without it a machine-level or user-level nuget.config — a
       corporate feed, say — is inherited, and with NuGetAudit plus TreatWarningsAsErrors an
       unreachable or authenticating feed fails the build with NU1900 on a machine that merely has
       one configured. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
