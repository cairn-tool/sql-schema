<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clearing inherited sources is not optional here. A machine-level or user-level nuget.config
       naming a corporate feed is inherited by these builds, and an unreachable or authenticating
       feed fails the restore outright. That is a real failure seen on a developer machine, not a
       hypothetical one. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
